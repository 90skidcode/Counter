<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/block_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/block_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textColor="@color/block_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/block_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/block_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/block_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/block_scope_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/block_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/block_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/block_primary"
            android:minHeight="52dp"
            android:text="@string/block_home"
            android:textColor="@color/block_text" />

        <Button
            android:id="@+id/block_override"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:textColor="@color/block_text" />

        <Button
            android:id="@+id/block_open_app"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/block_open_app"
            android:textColor="@color/block_text" />

        <Button
            android:id="@+id/block_pause"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textColor="@color/block_text_secondary" />

        <TextView
            android:id="@+id/block_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/block_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/block_footer"
            android:textColor="@color/block_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
